{
  "packages": {
    "gogcli": {
      "profile": "html",
      "version": "v0.11.0",
      "description": "gog: a single CLI for Gmail, Calendar, Drive, Contacts, Tasks, Sheets, Docs, Slides, and People.",
      "source": {
        "file": "docs/index.html",
        "decode": "html",
        "selectors": [
          {
            "selector": "meta[name='description']"
          },
          {
            "selector": "meta[property='og:description']"
          }
        ]
      }
    },
    "kakehashi": {
      "profile": "flake",
      "version": "v0.1.0",
      "description": "kakehashi - A Tree-sitter Language Server",
      "source": {
        "file": "flake.nix",
        "decode": "nix",
        "query": ".description // empty"
      }
    },
    "octorus": {
      "profile": "cargo",
      "version": "v0.4.2",
      "description": "A TUI tool for GitHub PR review, designed for Helix editor users",
      "source": {
        "file": "Cargo.toml",
        "decode": "toml",
        "query": ".package.description // empty"
      }
    }
  }
}
