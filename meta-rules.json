{
  "profiles": {
    "cargo": {
      "file": "Cargo.toml",
      "decode": "toml",
      "query": ".package.description // empty"
    },
    "npm": {
      "file": "package.json",
      "decode": "json",
      "query": ".description // empty"
    },
    "server-json": {
      "file": "server.json",
      "decode": "json",
      "query": ".description // empty"
    },
    "flake": {
      "file": "flake.nix",
      "decode": "nix",
      "query": ".description // empty"
    },
    "html": {
      "file": "index.html",
      "decode": "html",
      "selectors": [
        {
          "selector": "meta[name='description']"
        },
        {
          "selector": "meta[property='og:description']"
        }
      ]
    }
  },
  "packages": {
    "gogcli": {
      "profile": "html",
      "file": "docs/index.html"
    },
    "kubernetes-mcp-server": {
      "profile": "server-json"
    },
    "kakehashi": {
      "profile": "flake"
    },
    "octorus": {
      "profile": "cargo"
    },
    "zlib-rs": {
      "profile": "cargo",
      "query": ".workspace.package.description // empty"
    }
  }
}
