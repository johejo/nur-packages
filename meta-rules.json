{
  "profiles": {
    "cargo": {
      "file": "Cargo.toml",
      "decode": "toml",
      "fields": {
        "description": {
          "query": ".package.description // empty"
        },
        "homepage": {
          "query": ".package.homepage // .package.repository // empty"
        },
        "licenseSpdx": {
          "query": ".package.license // .workspace.package.license // empty"
        }
      }
    },
    "npm": {
      "file": "package.json",
      "decode": "json",
      "fields": {
        "description": {
          "query": ".description // empty"
        }
      }
    },
    "server-json": {
      "file": "server.json",
      "decode": "json",
      "fields": {
        "description": {
          "query": ".description // empty"
        }
      }
    },
    "flake": {
      "file": "flake.nix",
      "decode": "nix",
      "fields": {
        "description": {
          "query": ".description // empty"
        }
      }
    },
    "html": {
      "file": "index.html",
      "decode": "html",
      "fields": {
        "description": {
          "selectors": [
            {
              "selector": "meta[name='description']"
            },
            {
              "selector": "meta[property='og:description']"
            }
          ]
        }
      }
    }
  },
  "packages": {
    "gogcli": {
      "profile": "html",
      "file": "docs/index.html"
    },
    "kubernetes-mcp-server": {
      "profile": "server-json"
    },
    "zlib-rs": {
      "profile": "cargo",
      "fields": {
        "description": {
          "query": ".workspace.package.description // empty"
        }
      }
    }
  }
}
