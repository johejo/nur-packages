{
  "profiles": {
    "cargo-description": {
      "file": "Cargo.toml",
      "decode": "toml",
      "query": ".package.description // empty"
    },
    "npm-description": {
      "file": "package.json",
      "decode": "json",
      "query": ".description // empty"
    }
  },
  "packages": {
    "kakehashi": {
      "profile": "cargo-description",
      "file": "flake.nix",
      "decode": "nix",
      "query": ".description // empty"
    },
    "octorus": "cargo-description"
  }
}
